#!/usr/bin/env python3
"""Acquire a non-blocking exclusive lock, then run a command. Exit 0 if busy."""
from __future__ import annotations

import fcntl
import os
import signal
import subprocess
import sys


def main() -> int:
    if len(sys.argv) < 3:
        print("usage: flock-exec LOCK_PATH COMMAND [ARG...]", file=sys.stderr)
        return 2
    lock_path = sys.argv[1]
    command = sys.argv[2:]
    parent = os.path.dirname(lock_path)
    if parent:
        os.makedirs(parent, exist_ok=True)
    fd = os.open(lock_path, os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        return 0
    # Keep the non-inheritable descriptor in this parent while the guarded
    # command runs. Detached descendants therefore cannot outlive the command
    # while still owning the watchdog lock.
    child = subprocess.Popen(command)

    def forward_signal(signum: int, _frame: object) -> None:
        try:
            child.send_signal(signum)
        except ProcessLookupError:
            pass

    forwarded_signals = (signal.SIGTERM, signal.SIGINT, signal.SIGHUP)
    previous_handlers = {
        signum: signal.signal(signum, forward_signal) for signum in forwarded_signals
    }
    try:
        returncode = child.wait()
    finally:
        for signum, handler in previous_handlers.items():
            signal.signal(signum, handler)
    return returncode if returncode >= 0 else 128 - returncode


if __name__ == "__main__":
    raise SystemExit(main())
