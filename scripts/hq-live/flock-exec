#!/usr/bin/env python3
"""Acquire a non-blocking exclusive lock, then exec. Exit 0 if busy."""
from __future__ import annotations

import fcntl
import os
import sys


def main() -> int:
    if len(sys.argv) < 3:
        print("usage: flock-exec LOCK_PATH COMMAND [ARG...]", file=sys.stderr)
        return 2
    lock_path = sys.argv[1]
    command = sys.argv[2:]
    parent = os.path.dirname(lock_path)
    if parent:
        os.makedirs(parent, exist_ok=True)
    fd = os.open(lock_path, os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        return 0
    # Python file descriptors are non-inheritable by default. Keep this one
    # open across exec so the command, rather than this short wrapper, owns the
    # advisory lock for its full lifetime.
    os.set_inheritable(fd, True)
    os.execvp(command[0], command)
    return 127


if __name__ == "__main__":
    raise SystemExit(main())
