<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.engram.service.boot</string>
  <key>UserName</key>
  <string>bing</string>
  <key>GroupName</key>
  <string>staff</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/bing/.engram-service/current/bin/run-engram-service</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/bing</string>
    <key>USER</key>
    <string>bing</string>
    <key>LOGNAME</key>
    <string>bing</string>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>ENGRAM_REMOTE_OFFLOAD_PEER</key>
    <string>hq</string>
    <key>ENGRAM_LIVE_INGEST_PEER</key>
    <string>hq</string>
  </dict>
  <key>WorkingDirectory</key>
  <string>/Users/bing</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>Umask</key>
  <integer>63</integer>
  <key>StandardOutPath</key>
  <string>/Users/bing/.engram/logs/engram-service.boot.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/bing/.engram/logs/engram-service.boot.err.log</string>
</dict>
</plist>
