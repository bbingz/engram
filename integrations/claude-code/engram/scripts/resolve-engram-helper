#!/usr/bin/env bash
# Resolve Engram helper binaries without user-specific absolute paths.
# Preference order (first existing executable wins):
#   1) explicit env override
#   2) sibling of a known EngramCLI path
#   3) app-bundle Helpers (relative to discovered CLI, then /Applications)
set -euo pipefail

usage() {
  echo "Usage: resolve-engram-helper cli|mcp" >&2
  exit 64
}

[[ $# -eq 1 ]] || usage
kind="$1"

is_exec() {
  local path="$1"
  [[ -n "$path" && -f "$path" && -x "$path" ]]
}

resolve_override() {
  local value="$1"
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  if [[ "$value" == "~/"* ]]; then
    [[ -n "${HOME:-}" && "$HOME" == /* ]] || return 1
    value="${HOME}/${value#\~/}"
  fi
  if [[ "$value" == /* ]]; then
    is_exec "$value" || return 1
    printf '%s\n' "$value"
    return 0
  fi
  [[ "$value" != */* ]] || return 1
  local directory
  IFS=':' read -r -a path_directories <<< "${PATH:-}"
  for directory in "${path_directories[@]}"; do
    [[ "$directory" == /* ]] || continue
    if is_exec "${directory}/${value}"; then
      printf '%s\n' "${directory}/${value}"
      return 0
    fi
  done
  return 1
}

append_absolute_path_candidates() {
  local binary="$1"
  local directory
  IFS=':' read -r -a path_directories <<< "${PATH:-}"
  for directory in "${path_directories[@]}"; do
    [[ "$directory" == /* ]] || continue
    printf '%s\n' "${directory}/${binary}"
  done
}

emit_first_exec() {
  local candidate
  for candidate in "$@"; do
    if is_exec "$candidate"; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  return 1
}

resolve_cli() {
  # Explicit override is exclusive: a set-but-missing path fails closed so
  # callers can detect misconfiguration (SessionStart still fail-opens).
  if [[ -n "${ENGRAM_CLI_PATH:-}" ]]; then
    resolve_override "${ENGRAM_CLI_PATH}"
    return $?
  fi

  local candidates=(
    "/Applications/Engram.app/Contents/Helpers/EngramCLI"
    "/Applications/Engram.app/Contents/MacOS/EngramCLI"
  )
  while IFS= read -r candidate; do
    candidates+=("$candidate")
  done < <(append_absolute_path_candidates EngramCLI)
  emit_first_exec "${candidates[@]}"
}

resolve_mcp() {
  local candidates=()
  local cli=""
  local cli_dir=""

  if [[ -n "${ENGRAM_MCP_PATH:-}" ]]; then
    resolve_override "${ENGRAM_MCP_PATH}"
    return $?
  fi
  if [[ -n "${ENGRAM_CLI_MCP_HELPER:-}" ]]; then
    resolve_override "${ENGRAM_CLI_MCP_HELPER}"
    return $?
  fi

  if cli="$(resolve_cli 2>/dev/null)"; then
    cli_dir="$(cd "$(dirname "$cli")" && pwd)"
    candidates+=(
      "${cli_dir}/EngramMCP"
      "$(cd "${cli_dir}/.." && pwd)/Helpers/EngramMCP"
    )
  fi

  candidates+=(
    "/Applications/Engram.app/Contents/Helpers/EngramMCP"
    "/Applications/Engram.app/Contents/MacOS/EngramMCP"
  )
  while IFS= read -r candidate; do
    candidates+=("$candidate")
  done < <(append_absolute_path_candidates EngramMCP)
  emit_first_exec "${candidates[@]}"
}

case "$kind" in
  cli) resolve_cli ;;
  mcp) resolve_mcp ;;
  *) usage ;;
esac
